---
/** Page 58: today-I-learned sticky notes pinned to a cork board, with a tag filter. */
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getTils, tiltOf, hashStr } from '../../lib/content';
import { formatDay, slugTag } from '../../lib/daily';
import { url } from '../../lib/url';

const tils = await getTils();
const COLORS = ['s-yellow', 's-pink', 's-blue', 's-green', 's-orange'];
const excerpt = (body = '') => {
  const text = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/`([^`]+)`/g, '$1')
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_~-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return text.length > 150 ? `${text.slice(0, 147).replace(/\s+\S*$/, '')}…` : text;
};
const counts = new Map<string, number>();
for (const t of tils) for (const tag of t.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---
<Base title="Today I learned" description="Small things learned along the way, one sticky note each." active="til" paper="cork">
  <div id="til-root">
    <PageHead no={58} kicker="TIL · the cork board" title="Today I learned" lede="Small, true, useful. One note per thing; each note has its own page." />

    {tags.length > 0 && (
      <div class="log-tools">
        <div class="chips" role="group" aria-label="Filter notes by tag">
          <button type="button" class="chip" data-tag="" aria-pressed="true">all <span class="cnt">{tils.length}</span></button>
          {tags.map(([t, n]) => <button type="button" class="chip" data-tag={slugTag(t)} aria-pressed="false">#{t} <span class="cnt">{n}</span></button>)}
        </div>
        <p class="muted small" id="til-status" aria-live="polite" style="margin:0"></p>
      </div>
    )}

    {tils.length === 0 ? (
      <EmptyState title="Nothing pinned yet">Pin the first note with <code>npm run new:til -- "What I learned"</code> or the TIL tab in /admin.</EmptyState>
    ) : (
      <ul class="til-wall" data-stagger>
        {tils.map((t) => (
          <li
            class={`sticky ${COLORS[hashStr(t.id) % COLORS.length]}`}
            style={`--tilt:${tiltOf(t.id, 2.5)}deg`}
            data-tags={t.data.tags.map(slugTag).join(' ')}
            data-reveal
          >
            <span class="pin-dot" aria-hidden="true"></span>
            <p class="til-date"><time datetime={t.data.date}>{formatDay(t.data.date)}</time></p>
            <h2><a href={url(`/til/${t.id}/`)}>{t.data.title}</a></h2>
            <p class="til-body">{excerpt(t.body)}</p>
            {t.data.tags.length > 0 && <p class="til-tags">{t.data.tags.map((g) => <span>{g}</span>)}</p>}
            {t.data.sample && <span class="sample-note" role="note">sample</span>}
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>

<script>
  import { onPage } from '../../scripts/lifecycle';

  onPage('til-root', (root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const notes = [...root.querySelectorAll<HTMLElement>('.til-wall > li')];
    const status = root.querySelector('#til-status');
    function apply(tag: string) {
      let shown = 0;
      for (const n of notes) {
        const ok = !tag || (n.dataset.tags ?? '').split(' ').includes(tag);
        n.hidden = !ok;
        if (ok) shown++;
      }
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
      if (status) status.textContent = tag ? `${shown} ${shown === 1 ? 'note' : 'notes'} tagged #${tag}` : '';
      const u = new URL(location.href);
      if (tag) u.searchParams.set('tag', tag);
      else u.searchParams.delete('tag');
      history.replaceState(history.state, '', u);
    }
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.tag ?? '')));
    const initial = new URL(location.href).searchParams.get('tag');
    if (initial && buttons.some((b) => b.dataset.tag === initial)) apply(initial);
  });
</script>
